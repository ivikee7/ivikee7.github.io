---
import Layout from '../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';

const frontpageEntry = await getEntry('frontpage', 'frontpage');
const frontpage = frontpageEntry?.data;

const allDocs = await getCollection('docs');
const allPages = await getCollection('pages');
---

<Layout title={frontpage?.title || "Ivikee7 — Developer & Creator"}>

	<!-- HERO & PROFILE SECTION -->
	<section class="relative min-h-[85vh] max-w-7xl mx-auto px-6 pt-32 pb-24 flex flex-col justify-center items-center lg:flex-row-reverse gap-16 lg:gap-24">

		<!-- Right Content: Profile Image -->
		<div class="flex-1 flex justify-center lg:justify-end relative w-full max-w-sm lg:max-w-md">
			<div class="relative w-64 h-64 md:w-80 md:h-80 group">
				<!-- Soft Ambient Glow behind the image -->
				<div class="absolute inset-0 bg-fuchsia-600 rounded-full blur-[80px] opacity-30 group-hover:opacity-40 transition-opacity duration-500"></div>

				<!-- Clean Gradient Border -->
				<div class="relative w-full h-full rounded-full p-1.5 bg-gradient-to-tr from-violet-600 via-fuchsia-500 to-pink-500 shadow-2xl transition-transform duration-500 group-hover:scale-[1.02]">
					<img
						src="https://github.com/ivikee7.png"
						alt="Vikee Kumar Profile"
						class="w-full h-full object-cover rounded-full border-4 border-slate-950 bg-slate-900"
					/>
				</div>
			</div>
		</div>

		<!-- Left Content: Text & Actions -->
		<div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left z-10">

			<!-- Status Pill -->
			<div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-900/80 border border-slate-800 mb-8">
				<span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
				<span class="text-xs font-semibold tracking-wide text-slate-300">{frontpage?.subtitle || "Creative Developer"}</span>
			</div>

			<!-- Headlines -->
			<h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight leading-tight text-white pb-2 drop-shadow-sm">
				{frontpage?.heroTitle || "Crafting digital experiences"}
			</h1>

			<!-- Minimalist Tech Stack Badges -->
			<div class="mt-8 flex flex-wrap justify-center lg:justify-start gap-3">
				<span class="px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300 flex items-center gap-2 hover:bg-slate-800 transition-colors">
					🚀 AutoIt
				</span>
				<span class="px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300 flex items-center gap-2 hover:bg-slate-800 transition-colors">
					✨ Astro
				</span>
				<span class="px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300 flex items-center gap-2 hover:bg-slate-800 transition-colors">
					🎨 Tailwind CSS
				</span>
				<span class="px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300 flex items-center gap-2 hover:bg-slate-800 transition-colors">
					📦 17+ Repos
				</span>
			</div>

			<!-- Call to Actions -->
			<div class="mt-10 flex flex-col sm:flex-row justify-center lg:justify-start gap-4 w-full sm:w-auto">
				<a href="/docs" class="px-8 py-3.5 rounded-xl bg-violet-600 hover:bg-violet-500 font-semibold text-white shadow-lg shadow-violet-600/20 transition-all text-center">
					Browse Documentation
				</a>
				<a href="https://github.com/ivikee7" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 font-semibold text-slate-200 transition-all flex items-center justify-center gap-2">
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
					View GitHub
				</a>
			</div>
		</div>
	</section>

</Layout>