---
import Layout from '../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';

const frontpageEntry = await getEntry('frontpage', 'frontpage');
const frontpage = frontpageEntry?.data;

const allDocs = await getCollection('docs');
const allPages = await getCollection('pages');
---

<Layout title={frontpage?.title || "Ivikee7 — Portfolio & Docs"}>

	<!-- HERO SECTION -->
	<section class="relative max-w-7xl mx-auto px-6 pt-32 pb-24 flex flex-col items-center text-center">
		<div class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-slate-900/50 backdrop-blur-md border border-white/10 shadow-2xl mb-8 transition-transform hover:scale-105">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-indigo-500"></span>
      </span>
			<span class="text-sm font-medium text-slate-200">{frontpage?.subtitle || "Creative Developer & Designer"}</span>
		</div>

		<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight max-w-5xl leading-tight text-transparent bg-clip-text bg-gradient-to-br from-white to-slate-500 pb-2">
			{frontpage?.heroTitle || "Crafting digital experiences with precision & code"}
		</h1>

		<p class="mt-8 text-lg md:text-xl text-slate-400 max-w-2xl font-light leading-relaxed">
			{frontpage?.heroDescription || "Explore documentation and guides powered seamlessly by markdown collections."}
		</p>

		<div class="mt-12 flex flex-col sm:flex-row justify-center gap-4 w-full sm:w-auto">
			<a href="/docs" class="px-8 py-4 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 font-semibold text-white shadow-[0_0_30px_rgba(99,102,241,0.3)] transition-all hover:shadow-[0_0_40px_rgba(99,102,241,0.5)] hover:-translate-y-1">
				Browse Documentation
			</a>
			<a href="/pages" class="px-8 py-4 rounded-xl bg-slate-900/50 backdrop-blur-md hover:bg-slate-800/80 border border-white/10 font-semibold text-slate-200 transition-all hover:-translate-y-1">
				Explore Pages
			</a>
		</div>
	</section>

	<!-- DOCS PREVIEW SECTION -->
	<section class="max-w-7xl mx-auto px-6 py-24 relative">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>

		<div class="flex flex-col md:flex-row items-center justify-between mb-16 gap-6">
			<div>
				<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Documentation Guides</h2>
				<p class="text-slate-400 mt-2 text-lg">Latest technical specs and deep dives.</p>
			</div>
			<a href="/docs" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white/5 border border-white/10 text-sm font-medium text-white hover:bg-white/10 transition-colors">
				View All Docs <span aria-hidden="true">&rarr;</span>
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{allDocs.slice(0, 3).map((doc) => (
				<a href={`/docs/${doc.id}`} class="group relative flex flex-col justify-between rounded-3xl bg-slate-900/40 backdrop-blur-sm border border-white/10 p-8 hover:bg-slate-800/60 hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_10px_40px_rgba(99,102,241,0.1)]">
					<div>
						<div class="flex items-center gap-3 mb-4">
              <span class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              </span>
							<span class="text-xs font-semibold uppercase tracking-widest text-slate-500 group-hover:text-indigo-400 transition-colors">Guide</span>
						</div>
						<h3 class="text-2xl font-bold text-slate-200 group-hover:text-white transition-colors">{doc.data.title}</h3>
						<p class="text-slate-400 text-sm mt-3 line-clamp-2 leading-relaxed">{doc.data.description || "Click to read this comprehensive guide."}</p>
					</div>
					<div class="mt-8 flex items-center text-indigo-400 text-sm font-semibold opacity-0 group-hover:opacity-100 group-hover:-translate-y-1 transition-all">
						Read Article &rarr;
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- CONTACT SECTION -->
	<section id="contact" class="relative max-w-4xl mx-auto px-6 py-24">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>

		<div class="text-center mb-16">
			<h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">Let's Build Together</h2>
			<p class="text-slate-400 text-lg">Have a project in mind? Drop a message and I'll respond within 24 hours.</p>
		</div>

		<form id="contact-form" class="space-y-6 bg-slate-900/50 backdrop-blur-xl p-8 md:p-12 rounded-[2.5rem] border border-white/10 shadow-2xl relative overflow-hidden">
			<!-- Decorative form background blob -->
			<div class="absolute -top-24 -right-24 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
				<div class="space-y-2">
					<label class="text-sm font-medium text-slate-300 ml-1">Your Name</label>
					<input type="text" required class="w-full bg-slate-950/50 border border-white/10 rounded-2xl px-5 py-4 text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all" placeholder="John Doe">
				</div>
				<div class="space-y-2">
					<label class="text-sm font-medium text-slate-300 ml-1">Your Email</label>
					<input type="email" required class="w-full bg-slate-950/50 border border-white/10 rounded-2xl px-5 py-4 text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all" placeholder="john@example.com">
				</div>
			</div>
			<div class="space-y-2 relative">
				<label class="text-sm font-medium text-slate-300 ml-1">Message</label>
				<textarea rows="5" required class="w-full bg-slate-950/50 border border-white/10 rounded-2xl px-5 py-4 text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all resize-none" placeholder="Tell me about your project..."></textarea>
			</div>
			<button type="submit" class="w-full py-4 rounded-2xl bg-indigo-500 hover:bg-indigo-400 text-white font-bold text-lg shadow-[0_0_20px_rgba(99,102,241,0.25)] transition-all hover:shadow-[0_0_30px_rgba(99,102,241,0.4)] hover:-translate-y-0.5 relative z-10">
				Send Message
			</button>
			<p id="form-success" class="hidden text-center text-emerald-400 font-medium mt-4 bg-emerald-500/10 py-3 rounded-xl border border-emerald-500/20">✨ Message sent successfully! I'll be in touch soon.</p>
		</form>
	</section>

	<script>
		const contactForm = document.getElementById('contact-form') as HTMLFormElement;
		const formSuccess = document.getElementById('form-success');
		contactForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			contactForm.reset();
			formSuccess?.classList.remove('hidden');
			setTimeout(() => formSuccess?.classList.add('hidden'), 5000);
		});
	</script>
</Layout>