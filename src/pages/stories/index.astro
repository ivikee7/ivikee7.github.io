---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Stories Vault | Ivikee7" 
  description="Explore AI-generated stories, long kahani, cinematic video scripts, and prompt bibles live from the vault."
>
  <main class="max-w-7xl mx-auto px-6 py-12 md:py-20">
    <!-- Reader Mode View (Hidden by default, shown when a story is active) -->
    <div id="story-reader-view" class="hidden">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/10">
          <button id="back-to-catalog" class="inline-flex items-center gap-2 text-sm font-semibold text-purple-300 hover:text-white bg-purple-500/10 hover:bg-purple-500/20 px-4 py-2 rounded-full transition-all cursor-pointer border border-purple-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Stories Vault
          </button>
          
          <div class="flex items-center gap-3">
            <button id="copy-story-link" class="text-xs text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-700 px-3.5 py-2 rounded-xl border border-white/10 transition-colors flex items-center gap-1.5 cursor-pointer shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Copy Link</span>
            </button>
            <a id="view-on-github-link" href="#" target="_blank" rel="noopener noreferrer" class="text-xs text-purple-300 hover:text-white bg-purple-500/15 hover:bg-purple-500/25 px-3.5 py-2 rounded-xl border border-purple-500/30 transition-colors">
              GitHub &rarr;
            </a>
          </div>
        </div>

        <article class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-3xl p-6 md:p-12 shadow-2xl">
          <!-- Story Header -->
          <header class="mb-10 pb-8 border-b border-white/10">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span id="reader-category" class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30"></span>
              <span id="reader-read-time" class="text-xs text-slate-400"></span>
              <span id="reader-date" class="text-xs text-slate-400"></span>
            </div>
            <h1 id="reader-title" class="text-3xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4"></h1>
            <p id="reader-summary" class="text-lg text-slate-300 font-light leading-relaxed"></p>
            <div id="reader-tags" class="flex flex-wrap gap-2 mt-4"></div>
          </header>

          <!-- Story Narrative Content -->
          <div id="reader-content" class="prose prose-invert prose-purple prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-purple-400 prose-p:leading-relaxed prose-img:rounded-2xl">
            <!-- Dynamic story content will be injected here -->
          </div>
        </article>
      </div>
    </div>

    <!-- Catalog Explorer View (Default View) -->
    <div id="story-catalog-view">
      <!-- Enhanced Header Section -->
      <div class="mb-14 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-xs font-semibold mb-6 backdrop-blur-md shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Live Connected to <a href="https://github.com/ivikee7/stories" target="_blank" rel="noopener noreferrer" class="underline hover:text-white transition-colors ml-1 font-mono">ivikee7/stories</a>
        </div>
        
        <h1 class="text-5xl md:text-7xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-purple-200 to-pink-400 mb-6 drop-shadow-sm">
          Stories Vault
        </h1>

        <p class="text-slate-300 text-base md:text-xl leading-relaxed mb-6">
          Bilingual stories and moral narratives in Hindi and English — updated in real time.
        </p>

        <!-- Feature Tags -->
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-slate-400">
          <span class="px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-white/5 text-amber-300">🇮🇳 पूरी हिंदी कहानी (Hindi)</span>
          <span class="px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-white/5 text-indigo-300">🇺🇸 English Story</span>
          <span class="px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-white/5 text-purple-300">✨ Moral & Wisdom Lessons</span>
        </div>
      </div>
      <!-- Search & Filters -->
      <div class="mb-10 space-y-6">
        <!-- Search Bar -->
        <div class="relative max-w-xl mx-auto">
          <input 
            type="text" 
            id="story-search" 
            placeholder="Search stories, topics, prompts, or tags..." 
            class="w-full pl-12 pr-4 py-3.5 bg-slate-900/80 border border-white/10 rounded-2xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500 transition-all shadow-inner"
          />
          <svg class="w-5 h-5 text-slate-500 absolute left-4 top-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Category Pills -->
        <div id="category-pills" class="flex flex-wrap items-center justify-center gap-2">
          <button data-category="all" class="category-pill active px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-purple-600 text-white shadow-lg shadow-purple-600/30">
            All Stories (<span id="count-all">0</span>)
          </button>
        </div>
      </div>

      <!-- Loading State -->
      <div id="stories-loading" class="text-center py-24">
        <div class="inline-block w-10 h-10 border-4 border-purple-500/30 border-t-purple-500 rounded-full animate-spin mb-4"></div>
        <p class="text-slate-400 text-sm">Fetching stories from <code class="text-purple-300">ivikee7/stories</code>...</p>
      </div>

      <!-- Error State -->
      <div id="stories-error" class="hidden max-w-xl mx-auto text-center py-16 px-6 rounded-3xl bg-red-950/20 border border-red-500/30">
        <div class="text-red-400 text-3xl mb-3">⚠️</div>
        <h3 class="text-xl font-bold text-white mb-2">Unable to Load Stories</h3>
        <p id="error-message" class="text-slate-400 text-sm mb-6"></p>
        <button id="retry-btn" class="px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-sm font-semibold transition-colors">
          Retry Fetching
        </button>
      </div>

      <!-- Empty / Getting Started State -->
      <div id="stories-empty" class="hidden max-w-2xl mx-auto text-center py-16 px-8 rounded-3xl bg-slate-900/40 border border-white/10 backdrop-blur-sm">
        <div class="text-4xl mb-4">📖</div>
        <h3 class="text-2xl font-bold text-white mb-3">Your Stories Vault is Ready!</h3>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Your website is live-synced with <a href="https://github.com/ivikee7/stories" target="_blank" class="text-purple-400 underline">github.com/ivikee7/stories</a>. 
          To add stories, simply push markdown (<code class="text-purple-300">.md</code>) files into your repo.
        </p>

        <div class="text-left bg-slate-950 p-5 rounded-2xl border border-white/5 text-xs font-mono text-slate-300 mb-6 overflow-x-auto">
          <p class="text-slate-500 mb-2">// Example file: stories/kahani/lost-realm.md</p>
          <pre>---
title: "The Lost Realm"
category: "kahani"
summary: "An ancient king discovers a hidden gateway beneath the Himalayas."
tags: ["kahani", "ancient", "adventure"]
prompts:
  video_prompt: "Cinematic drone shot of Himalayan snow peaks at sunset, 8k..."
---

Your full story narrative starts here...</pre>
        </div>

        <a href="https://github.com/ivikee7/stories/new/main" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all shadow-lg shadow-purple-600/30">
          Create First Story on GitHub &rarr;
        </a>
      </div>

      <!-- Stories Grid -->
      <div id="stories-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>
  </main>
</Layout>

<script>
  import { marked } from 'https://cdn.jsdelivr.net/npm/marked@15.0.7/+esm';

  const GITHUB_REPO = 'ivikee7/stories';
  const BRANCH = 'main';
  const GITHUB_TREE_URL = `https://api.github.com/repos/${GITHUB_REPO}/git/trees/${BRANCH}?recursive=1`;
  const RAW_CONTENT_BASE = `https://raw.githubusercontent.com/ivikee7/${GITHUB_REPO.split('/')[1]}/${BRANCH}`;
  const JSDELIVR_BASE = `https://cdn.jsdelivr.net/gh/${GITHUB_REPO}@${BRANCH}`;

  interface StoryMeta {
    path: string;
    slug: string;
    title: string;
    title_hi?: string;
    title_en?: string;
    category: string;
    categoryDisplay: string;
    language?: string;
    summary: string;
    tags: string[];
    date?: string;
    prompts?: Record<string, any>;
    content?: string;
    readTime?: string;
  }

  let allStories: StoryMeta[] = [];
  let currentActiveStory: StoryMeta | null = null;
  let currentCategory = 'all';
  let currentLang = 'hi';
  let searchQuery = '';
  let activeBranch = 'main';

  const loadingEl = document.getElementById('stories-loading');
  const errorEl = document.getElementById('stories-error');
  const errorMessageEl = document.getElementById('error-message');
  const emptyEl = document.getElementById('stories-empty');
  const gridEl = document.getElementById('stories-grid');
  const pillsEl = document.getElementById('category-pills');
  const searchInput = document.getElementById('story-search') as HTMLInputElement;
  const countAllEl = document.getElementById('count-all');
  const catalogView = document.getElementById('story-catalog-view');
  const readerView = document.getElementById('story-reader-view');
  const retryBtn = document.getElementById('retry-btn');

  // Reader Elements
  const backToCatalogBtn = document.getElementById('back-to-catalog');
  const readerCategory = document.getElementById('reader-category');
  const readerReadTime = document.getElementById('reader-read-time');
  const readerDate = document.getElementById('reader-date');
  const readerTitle = document.getElementById('reader-title');
  const readerSummary = document.getElementById('reader-summary');
  const readerTags = document.getElementById('reader-tags');
  const readerContent = document.getElementById('reader-content');
  const readerPromptsBox = document.getElementById('reader-prompts-box');
  const readerPromptsContent = document.getElementById('reader-prompts-content');
  const copyPromptsBtn = document.getElementById('copy-prompts-btn');
  const copyStoryLink = document.getElementById('copy-story-link');
  const viewOnGithubLink = document.getElementById('view-on-github-link') as HTMLAnchorElement;

  // Simple client-side YAML frontmatter parser for markdown files
  function parseFrontmatter(rawText: string) {
    let metadata: Record<string, any> = {};
    let content = rawText;

    const match = rawText.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
    if (match) {
      const yamlBlock = match[1];
      content = match[2];

      const lines = yamlBlock.split('\n');
      let isInPromptsBlock = false;
      let promptsObj: Record<string, string> = {};

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith('#')) continue;

        if (trimmed.startsWith('prompts:')) {
          isInPromptsBlock = true;
          continue;
        }

        if (isInPromptsBlock && line.startsWith('  ')) {
          const colonIdx = trimmed.indexOf(':');
          if (colonIdx !== -1) {
            const pKey = trimmed.slice(0, colonIdx).trim();
            const pVal = trimmed.slice(colonIdx + 1).trim().replace(/^["']|["']$/g, '');
            promptsObj[pKey] = pVal;
          }
          continue;
        } else {
          isInPromptsBlock = false;
        }

        const colonIdx = line.indexOf(':');
        if (colonIdx !== -1) {
          const key = line.slice(0, colonIdx).trim();
          let value = line.slice(colonIdx + 1).trim().replace(/^["']|["']$/g, '');

          if (value.startsWith('[') && value.endsWith(']')) {
            metadata[key] = value.slice(1, -1).split(',').map(s => s.trim().replace(/^["']|["']$/g, ''));
          } else {
            metadata[key] = value;
          }
        }
      }

      if (Object.keys(promptsObj).length > 0) {
        metadata['prompts'] = promptsObj;
      }
    }

    return { metadata, content };
  }

  // Universal parser for both Markdown (.md) and AI Video JSON (.json)
  function parseStoryData(rawText: string, filePath: string) {
    if (filePath.endsWith('.json')) {
      try {
        const data = JSON.parse(rawText);
        let title = '';
        if (data.title_hi && data.title_en) {
          title = `${data.title_hi} (${data.title_en})`;
        } else if (data.title_hi) {
          title = data.title_hi;
        } else if (data.title_en) {
          title = data.title_en;
        } else if (typeof data.title === 'string') {
          title = data.title;
        } else if (data.title && typeof data.title === 'object') {
          const hi = data.title.hi || '';
          const en = data.title.en || '';
          if (hi && en) title = `${hi} (${en})`;
          else title = hi || en || Object.values(data.title)[0] || '';
        }

        const subHook = data.sub_hook || '';
        let summary = subHook || data.summary || data.description || '';
        let language = data.language || '';
        if (!language) {
          if (data.title_hi && data.title_en) language = 'Hindi & English';
          else if (data.title_hi) language = 'Hindi';
          else if (data.title_en) language = 'English';
        }

        // Sub-hook Moral Callout
        let subHookHtml = '';
        if (subHook) {
          subHookHtml = `
            <div class="mb-8 inline-flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-gradient-to-r from-amber-500/10 to-purple-500/10 border border-amber-500/30 text-amber-200 text-sm font-semibold shadow-lg">
              <span class="text-base">💡</span>
              <span>${subHook}</span>
            </div>
          `;
        }

        // Build Hindi Reader and English Reader
        let hindiStoryHtml = '';
        let englishStoryHtml = '';
        let fullHindiText = '';
        let fullEnglishText = '';

        const scenes = Array.isArray(data.scenes) ? data.scenes : (Array.isArray(data.shots) ? data.shots : []);
        
        if (scenes.length > 0) {
          scenes.forEach((sc: any) => {
            const voHi = sc.hi || sc.voiceover_hi || (typeof sc.voiceover === 'object' ? sc.voiceover?.hi : (typeof sc.voiceover === 'string' ? sc.voiceover : ''));
            const voEn = sc.en || sc.voiceover_en || (typeof sc.voiceover === 'object' ? sc.voiceover?.en : '');

            if (voHi) fullHindiText += `${voHi}\n\n`;
            if (voEn) fullEnglishText += `${voEn}\n\n`;
          });

          // 1. Full Hindi Story View (Continuous Prose / Paragraphs)
          const hindiParagraphs = scenes.map((sc: any) => {
            const voHi = sc.hi || sc.voiceover_hi || (typeof sc.voiceover === 'object' ? sc.voiceover?.hi : (typeof sc.voiceover === 'string' ? sc.voiceover : ''));
            if (!voHi) return '';
            const parts = String(voHi).split(/\r?\n\s*\r?\n|\r?\n/).map(p => p.trim()).filter(Boolean);
            return parts.map(p => `<p class="text-lg md:text-xl text-slate-100 font-sans leading-[2] md:leading-[2.2] tracking-wide">${p}</p>`).join('');
          }).filter(Boolean).join('');

          hindiStoryHtml = `
            <div class="story-article-flow">
              <div class="flex items-center justify-between pb-5 mb-8 border-b border-white/10">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                  <span class="text-xs md:text-sm font-bold text-amber-300 uppercase tracking-wider">सम्पूर्ण हिंदी कहानी</span>
                  <span class="text-xs text-slate-400 ml-2">(${scenes.length} दृश्य / Scenes)</span>
                </div>
                <button class="copy-full-text-btn inline-flex items-center gap-2 text-xs font-semibold bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 px-3.5 py-1.5 rounded-xl transition-all cursor-pointer shadow-sm active:scale-95" data-text="${encodeURIComponent(fullHindiText.trim())}">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                  <span>Copy Hindi Story</span>
                </button>
              </div>

              <div class="story-prose space-y-6 md:space-y-8 max-w-none">
                ${hindiParagraphs || '<p class="text-slate-400 italic">इस कहानी का हिंदी पाठ उपलब्ध नहीं है।</p>'}
              </div>

              ${subHook ? `
                <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-purple-500/10 to-transparent border border-amber-500/30 shadow-lg flex items-start gap-3.5">
                  <span class="text-2xl mt-0.5">💡</span>
                  <div>
                    <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-1">कहानी की मुख्य सीख (Moral)</div>
                    <div class="text-base md:text-lg text-amber-100 font-semibold">${subHook}</div>
                  </div>
                </div>
              ` : ''}
            </div>
          `;

          // 2. Full English Story View (Continuous Prose / Paragraphs)
          const englishParagraphs = scenes.map((sc: any) => {
            const voEn = sc.en || sc.voiceover_en || (typeof sc.voiceover === 'object' ? sc.voiceover?.en : '');
            if (!voEn) return '';
            const parts = String(voEn).split(/\r?\n\s*\r?\n|\r?\n/).map(p => p.trim()).filter(Boolean);
            return parts.map(p => `<p class="text-lg md:text-xl text-slate-200 font-sans leading-relaxed md:leading-loose tracking-normal">${p}</p>`).join('');
          }).filter(Boolean).join('');

          englishStoryHtml = `
            <div class="story-article-flow">
              <div class="flex items-center justify-between pb-5 mb-8 border-b border-white/10">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-indigo-400"></span>
                  <span class="text-xs md:text-sm font-bold text-indigo-300 uppercase tracking-wider">Complete English Story</span>
                  <span class="text-xs text-slate-400 ml-2">(${scenes.length} Scenes)</span>
                </div>
                <button class="copy-full-text-btn inline-flex items-center gap-2 text-xs font-semibold bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 border border-indigo-500/30 px-3.5 py-1.5 rounded-xl transition-all cursor-pointer shadow-sm active:scale-95" data-text="${encodeURIComponent(fullEnglishText.trim())}">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                  <span>Copy English Story</span>
                </button>
              </div>

              <div class="story-prose space-y-6 md:space-y-7 max-w-none">
                ${englishParagraphs || '<p class="text-slate-400 italic">English story text is not available for this entry.</p>'}
              </div>

              ${subHook ? `
                <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-indigo-500/10 via-purple-500/10 to-transparent border border-indigo-500/30 shadow-lg flex items-start gap-3.5">
                  <span class="text-2xl mt-0.5">💡</span>
                  <div>
                    <div class="text-xs font-bold text-indigo-400 uppercase tracking-wider mb-1">Moral of the Story</div>
                    <div class="text-base md:text-lg text-indigo-100 font-semibold">${subHook}</div>
                  </div>
                </div>
              ` : ''}
            </div>
          `;
        }

        // View Tabs Header: ONLY Hindi & English
        const tabsHeaderHtml = `
          <div class="flex items-center gap-2 mb-8 p-1.5 rounded-2xl bg-slate-950 border border-white/10 w-fit">
            <button class="story-lang-tab active px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/20 transition-all cursor-pointer flex items-center gap-2" data-target="tab-hindi">
              <span>🇮🇳</span> पूरी हिंदी कहानी (Hindi)
            </button>
            <button class="story-lang-tab px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold bg-slate-900/80 text-indigo-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-2" data-target="tab-english">
              <span>🇺🇸</span> English Story
            </button>
          </div>
        `;

        let htmlContent = `
          ${tabsHeaderHtml}
          <div id="tab-hindi" class="story-tab-pane">
            ${hindiStoryHtml}
          </div>
          <div id="tab-english" class="story-tab-pane hidden">
            ${englishStoryHtml}
          </div>
        `;

        if (data.story || data.narrative || data.content) {
          const text = data.story || data.narrative || data.content;
          htmlContent = marked.parse(text) + htmlContent;
        }

        if (!htmlContent) {
          htmlContent = `<pre class="p-5 rounded-2xl bg-slate-950 font-mono text-xs text-slate-300 overflow-x-auto border border-white/5">${JSON.stringify(data, null, 2)}</pre>`;
        }

        let tags: string[] = [];
        if (Array.isArray(data.tags)) tags = data.tags;
        else if (data.youtube_metadata?.tags) tags = data.youtube_metadata.tags;

        let prompts: Record<string, any> = data.prompts || {};
        if (data.youtube_metadata?.title_options) {
          prompts['YouTube Titles'] = data.youtube_metadata.title_options.join('\n');
        }
        if (data.youtube_metadata?.description) {
          prompts['YouTube Description'] = data.youtube_metadata.description;
        }

        return {
          slug: data.slug || '',
          title,
          title_hi: data.title_hi || (typeof data.title === 'object' ? data.title.hi : ''),
          title_en: data.title_en || (typeof data.title === 'object' ? data.title.en : ''),
          summary: summary || (scenes[0]?.prompt ? scenes[0].prompt.slice(0, 140) + '...' : ''),
          language,
          tags,
          prompts,
          htmlContent,
          readTime: `${Math.max(1, Math.ceil(scenes.length * 0.5))} min read`
        };
      } catch (e) {
        console.warn('JSON parse error in', filePath, e);
      }
    }

    // Markdown fallback
    const { metadata, content } = parseFrontmatter(rawText);
    const mdLang = metadata.language || '';
    let title_hi = metadata.title_hi || '';
    let title_en = metadata.title_en || '';
    if (!title_hi && (mdLang.toLowerCase().includes('hindi') || filePath.includes('_hi.') || filePath.includes('-hi.'))) {
      title_hi = metadata.title || '';
    }
    if (!title_en && (mdLang.toLowerCase().includes('english') || filePath.includes('_en.') || filePath.includes('-en.'))) {
      title_en = metadata.title || '';
    }

    return {
      slug: metadata.slug || '',
      title: metadata.title,
      title_hi,
      title_en,
      summary: metadata.summary || metadata.description || content.slice(0, 160).replace(/[#*`_]/g, '').trim() + '...',
      language: mdLang,
      tags: Array.isArray(metadata.tags) ? metadata.tags : (metadata.tags ? [metadata.tags] : []),
      prompts: metadata.prompts || {},
      htmlContent: marked.parse(content),
      readTime: calculateReadTime(content)
    };
  }

  // Format helpers
  function formatTitleFromSlug(slug: string): string {
    return slug
      .replace(/[_-]/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());
  }

  function formatCategoryName(cat: string): string {
    return cat
      .replace(/_/g, ' ')
      .replace(/-/g, ' ')
      .replace(/\band\b/gi, '&')
      .replace(/\b\w/g, c => c.toUpperCase());
  }

  // Calculate read time
  function calculateReadTime(text: string): string {
    const words = text.trim().split(/\s+/).length;
    const minutes = Math.ceil(words / 200);
    return `${minutes} min read`;
  }

  // Fetch story file content with 3-tier fallback (Raw -> CDN -> API Base64)
  async function fetchStoryContent(filePath: string, branch = 'main'): Promise<string> {
    // 1. Try raw.githubusercontent.com directly
    try {
      const res = await fetch(`https://raw.githubusercontent.com/${GITHUB_REPO}/${branch}/${filePath}`);
      if (res.ok) return await res.text();
    } catch (_) {}

    // 2. Try jsDelivr CDN
    try {
      const cdnRes = await fetch(`https://cdn.jsdelivr.net/gh/${GITHUB_REPO}@${branch}/${filePath}`);
      if (cdnRes.ok) return await cdnRes.text();
    } catch (_) {}

    // 3. Fallback to GitHub API (handles Unicode & Devanagari/Hindi properly)
    try {
      const apiRes = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/contents/${filePath}?ref=${branch}`);
      if (apiRes.ok) {
        const fileData = await apiRes.json();
        if (fileData.content) {
          const binaryString = atob(fileData.content.replace(/\s/g, ''));
          const bytes = Uint8Array.from(binaryString, c => c.charCodeAt(0));
          return new TextDecoder('utf-8').decode(bytes);
        }
      }
    } catch (_) {}

    throw new Error(`Could not fetch story file: ${filePath}`);
  }

  // Fetch all stories metadata from GitHub tree API
  async function loadStories() {
    try {
      loadingEl?.classList.remove('hidden');
      errorEl?.classList.add('hidden');
      emptyEl?.classList.add('hidden');
      if (gridEl) gridEl.innerHTML = '';

      let tree: any[] = [];
      let activeBranch = BRANCH;

      // 1. Check repository info to determine default branch
      try {
        const repoRes = await fetch(`https://api.github.com/repos/${GITHUB_REPO}`);
        if (repoRes.ok) {
          const repoData = await repoRes.json();
          activeBranch = repoData.default_branch || 'main';
        } else if (repoRes.status === 404) {
          throw new Error(`Repository https://github.com/${GITHUB_REPO} was not found. Please ensure the repository is Public.`);
        } else if (repoRes.status === 403) {
          throw new Error('GitHub API hourly rate limit reached. Please wait a few minutes or retry.');
        }
      } catch (err: any) {
        if (err.message && (err.message.includes('not found') || err.message.includes('rate limit'))) {
          throw err;
        }
      }

      // 2. Fetch tree from git trees API
      const treeUrl = `https://api.github.com/repos/${GITHUB_REPO}/git/trees/${activeBranch}?recursive=1`;
      const res = await fetch(treeUrl);

      if (!res.ok) {
        if (res.status === 409 || res.status === 404) {
          showEmpty();
          return;
        } else if (res.status === 403) {
          throw new Error('GitHub API rate limit exceeded. Please retry in a few moments.');
        } else {
          // Try fallback to master branch
          const fallbackRes = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/git/trees/master?recursive=1`);
          if (fallbackRes.ok) {
            const data = await fallbackRes.json();
            tree = data.tree || [];
          } else {
            showEmpty();
            return;
          }
        }
      } else {
        const data = await res.json();
        tree = data.tree || [];
      }

      // Filter for markdown, text, and json story files (excluding README, templates, configs)
      const storyFiles = tree.filter((item: any) => 
        item.type === 'blob' && 
        /\.(md|markdown|txt|json)$/i.test(item.path) &&
        !/readme\.md$/i.test(item.path) &&
        !/templates\//i.test(item.path) &&
        !/package(-lock)?\.json$/i.test(item.path) &&
        !/tsconfig.*\.json$/i.test(item.path)
      );

      if (storyFiles.length === 0) {
        showEmpty();
        return;
      }

      // Build instant stories list directly from tree structure
      allStories = storyFiles.map((file: any): StoryMeta => {
        const pathSegments = file.path.split('/');
        let rawCategory = 'general';
        let storyFolder = '';
        let fileName = pathSegments[pathSegments.length - 1];
        let fileSlug = fileName.replace(/\.[^/.]+$/, '');

        if (pathSegments.length >= 3) {
          rawCategory = pathSegments[0];
          storyFolder = pathSegments[1];
        } else if (pathSegments.length === 2) {
          rawCategory = pathSegments[0];
          storyFolder = fileSlug;
        } else {
          storyFolder = fileSlug;
        }

        const categoryKey = rawCategory.toLowerCase();
        const categoryDisplay = formatCategoryName(categoryKey);

        let language = '';
        const lowerPath = file.path.toLowerCase();
        if (lowerPath.includes('_hi.') || lowerPath.includes('-hi.') || lowerPath.includes('hindi')) {
          language = 'Hindi';
        } else if (lowerPath.includes('_en.') || lowerPath.includes('-en.') || lowerPath.includes('english')) {
          language = 'English';
        }

        let title = formatTitleFromSlug(storyFolder);
        if (language && !title.toLowerCase().includes(language.toLowerCase())) {
          title += ` (${language})`;
        }

        const tags = [categoryDisplay.toLowerCase()];
        if (language) tags.push(language.toLowerCase());

        return {
          path: file.path,
          slug: fileSlug,
          title: title || fileName,
          category: categoryKey,
          categoryDisplay,
          language,
          summary: `Story script from ${categoryDisplay} • ${storyFolder}`,
          tags,
          readTime: 'Read Story'
        };
      });

      renderCategories();
      renderGrid();
      checkDeepLink();

      // Lazy-load titles & summaries in the background
      storyFiles.forEach(async (file: any) => {
        try {
          const raw = await fetchStoryContent(file.path, activeBranch);
          const parsed = parseStoryData(raw, file.path);
          const story = allStories.find(s => s.path === file.path);
          if (story) {
            story.content = parsed.htmlContent;
            story.prompts = parsed.prompts;
            if (parsed.title) story.title = parsed.title;
            if (parsed.title_hi) story.title_hi = parsed.title_hi;
            if (parsed.title_en) story.title_en = parsed.title_en;
            if (parsed.slug) story.slug = parsed.slug;
            if (parsed.summary) story.summary = parsed.summary;
            if (parsed.language) story.language = parsed.language;
            if (parsed.tags && parsed.tags.length > 0) story.tags = parsed.tags;
            if (parsed.readTime) story.readTime = parsed.readTime;
            renderGrid();
          }
        } catch (_) {}
      });

      renderCategories();
      renderGrid();
      checkDeepLink();

    } catch (err: any) {
      console.error(err);
      loadingEl?.classList.add('hidden');
      errorEl?.classList.remove('hidden');
      if (errorMessageEl) {
        errorMessageEl.textContent = err.message || 'Failed to connect to GitHub repository.';
      }
    } finally {
      loadingEl?.classList.add('hidden');
    }
  }

  function showEmpty() {
    loadingEl?.classList.add('hidden');
    emptyEl?.classList.remove('hidden');
    if (countAllEl) countAllEl.textContent = '0';
  }

  function renderCategories() {
    const categoriesMap = new Map<string, string>();
    allStories.forEach(s => {
      categoriesMap.set(s.category, s.categoryDisplay);
    });

    if (countAllEl) countAllEl.textContent = String(allStories.length);

    if (!pillsEl) return;
    pillsEl.innerHTML = `
      <button data-category="all" class="category-pill active px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-purple-600 text-white shadow-lg shadow-purple-600/30">
        All Stories (${allStories.length})
      </button>
      ${Array.from(categoriesMap.entries()).map(([catKey, catName]) => {
        const count = allStories.filter(s => s.category === catKey).length;
        return `
          <button data-category="${catKey}" class="category-pill px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-white/10">
            ${catName} (${count})
          </button>
        `;
      }).join('')}
    `;

    pillsEl.querySelectorAll('.category-pill').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const cat = target.getAttribute('data-category') || 'all';
        currentCategory = cat;

        pillsEl.querySelectorAll('.category-pill').forEach(b => {
          b.className = 'category-pill px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-white/10';
        });

        target.className = 'category-pill active px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-purple-600 text-white shadow-lg shadow-purple-600/30';
        renderGrid();
      });
    });
  }

  function renderGrid() {
    if (!gridEl) return;

    const filtered = allStories.filter(story => {
      const matchesCategory = currentCategory === 'all' || story.category === currentCategory;
      const q = searchQuery.toLowerCase();
      const matchesSearch = !q || 
        story.title.toLowerCase().includes(q) || 
        story.summary.toLowerCase().includes(q) ||
        story.categoryDisplay.toLowerCase().includes(q) ||
        (story.language && story.language.toLowerCase().includes(q)) ||
        story.tags.some(t => t.toLowerCase().includes(q));

      return matchesCategory && matchesSearch;
    });

    if (filtered.length === 0) {
      gridEl.innerHTML = `
        <div class="col-span-full text-center py-16">
          <p class="text-slate-400 text-lg">No stories found matching your filter.</p>
        </div>
      `;
      return;
    }

    gridEl.innerHTML = filtered.map(story => {
      const cleanSlug = story.slug || (story.path ? story.path.replace(/\.[^/.]+$/, '').split('/').pop() : '') || 'story';
      return `
      <a 
        href="/stories?story=${encodeURIComponent(cleanSlug)}&lang=hi"
        data-story-path="${story.path}"
        class="story-card block group relative flex flex-col justify-between rounded-3xl bg-slate-900/40 backdrop-blur-sm border border-white/10 p-7 hover:bg-slate-800/60 hover:border-purple-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_10px_40px_rgba(168,85,247,0.15)] cursor-pointer no-underline text-inherit"
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-lg bg-purple-500/20 text-purple-300 border border-purple-500/30">
                ${story.categoryDisplay}
              </span>
              ${story.language ? `
                <span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30">
                  ${story.language === 'Hindi' ? '🇮🇳 ' : '🇺🇸 '}${story.language}
                </span>
              ` : ''}
            </div>
            <span class="text-xs text-slate-400">${story.readTime}</span>
          </div>

          <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors mb-3 leading-snug">
            ${story.title}
          </h3>

          <p class="text-slate-400 text-sm leading-relaxed mb-6 line-clamp-3">
            ${story.summary}
          </p>
        </div>

        <div>
          ${(story.tags && story.tags.length > 0) ? `
            <div class="flex flex-wrap gap-1.5 mb-6">
              ${story.tags.slice(0, 3).map(tag => `
                <span class="text-[10px] bg-slate-800/90 text-slate-400 px-2 py-0.5 rounded-md border border-white/5">#${tag}</span>
              `).join('')}
            </div>
          ` : ''}

          <div class="flex items-center text-purple-400 text-sm font-semibold group-hover:translate-x-1 transition-transform">
            Read Story (Hindi & English) &rarr;
          </div>
        </div>
      </a>
    `;}).join('');
  }

  // Event delegation on grid: reliable clicks always
  gridEl?.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.story-card');
    if (card) {
      e.preventDefault();
      const path = card.getAttribute('data-story-path');
      const story = allStories.find(s => s.path === path);
      if (story) {
        openStoryReader(story, true);
      } else {
        const href = card.getAttribute('href');
        if (href) window.location.href = href;
      }
    }
  });

  function updateStorySeo(story: StoryMeta, langCode: string) {
    let title = story.title;
    let desc = story.summary;

    if (langCode === 'en') {
      const enTitle = story.title_en || story.title;
      title = `${enTitle} — Complete English Story | Ivikee7`;
      desc = `Complete English story narrative and dialogues: ${enTitle}. ${story.summary || ''}`.trim();
    } else {
      const hiTitle = story.title_hi || story.title;
      title = `${hiTitle} — पूरी हिंदी कहानी (Hindi Story) | Ivikee7`;
      desc = `पूरी हिंदी कहानी और संवाद: ${hiTitle}. ${story.summary || ''}`.trim();
    }

    document.title = title;

    // Update meta tags dynamically for social preview & search bots
    const metaDesc = document.querySelector('meta[name="description"]');
    if (metaDesc) metaDesc.setAttribute('content', desc);
    const ogTitle = document.querySelector('meta[property="og:title"]');
    if (ogTitle) ogTitle.setAttribute('content', title);
    const ogDesc = document.querySelector('meta[property="og:description"]');
    if (ogDesc) ogDesc.setAttribute('content', desc);
    const twitterTitle = document.querySelector('meta[property="twitter:title"]');
    if (twitterTitle) twitterTitle.setAttribute('content', title);
    const twitterDesc = document.querySelector('meta[property="twitter:description"]');
    if (twitterDesc) twitterDesc.setAttribute('content', desc);
    const canonical = document.querySelector('link[rel="canonical"]');
    if (canonical) canonical.setAttribute('href', window.location.href);
  }

  function switchStoryTab(targetId: string, updateUrl = true) {
    if (!readerContent) return;

    const langCode = targetId === 'tab-english' ? 'en' : 'hi';
    currentLang = langCode;

    // Toggle tab button active styles
    readerContent.querySelectorAll('.story-lang-tab').forEach(t => {
      const tTarget = (t as HTMLElement).getAttribute('data-target');
      if (tTarget === targetId) {
        if (targetId === 'tab-hindi') {
          t.className = 'story-lang-tab active px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/20 transition-all cursor-pointer flex items-center gap-2';
        } else {
          t.className = 'story-lang-tab active px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 transition-all cursor-pointer flex items-center gap-2';
        }
      } else {
        if (tTarget === 'tab-hindi') {
          t.className = 'story-lang-tab px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold bg-slate-900/80 text-amber-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-2';
        } else {
          t.className = 'story-lang-tab px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold bg-slate-900/80 text-indigo-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-2';
        }
      }
    });

    // Toggle content panes
    readerContent.querySelectorAll('.story-tab-pane').forEach(pane => {
      pane.classList.add('hidden');
    });
    const activePane = readerContent.querySelector(`#${targetId}`);
    activePane?.classList.remove('hidden');

    // Update SEO
    if (currentActiveStory) {
      updateStorySeo(currentActiveStory, langCode);
    }

    // Reflect language in URL for SEO and direct bookmarking
    if (updateUrl && currentActiveStory) {
      try {
        const newUrl = new URL(window.location.href);
        const cleanSlug = currentActiveStory.slug || (currentActiveStory.path ? currentActiveStory.path.replace(/\.[^/.]+$/, '').split('/').pop() : '') || 'story';
        newUrl.searchParams.set('story', cleanSlug);
        newUrl.searchParams.set('lang', langCode);
        window.history.replaceState({ storyPath: currentActiveStory.path, lang: langCode }, '', newUrl.toString());
      } catch (e) {
        console.error('Failed to replace state in switchStoryTab:', e);
      }
    }
  }

  function openStoryReader(story: StoryMeta, updateUrl = true, initialLang?: string) {
    if (!story) return;
    currentActiveStory = story;
    catalogView?.classList.add('hidden');
    readerView?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });

    const langCode = (initialLang === 'en' || initialLang === 'english') ? 'en' : 'hi';
    currentLang = langCode;

    // Immediately update URL when opening a story
    if (updateUrl) {
      try {
        const cleanSlug = story.slug || (story.path ? story.path.replace(/\.[^/.]+$/, '').split('/').pop() : '') || 'story';
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('story', cleanSlug);
        newUrl.searchParams.set('lang', langCode);
        window.history.pushState({ storyPath: story.path, lang: langCode }, '', newUrl.toString());
      } catch (e) {
        console.error('pushState error in openStoryReader:', e);
      }
    }

    if (readerCategory) {
      readerCategory.textContent = (story.categoryDisplay || 'Story') + (story.language ? ` • ${story.language}` : '');
    }
    if (readerReadTime) readerReadTime.textContent = story.readTime ? `• ${story.readTime}` : '';
    if (readerDate) readerDate.textContent = story.date ? `• ${story.date}` : '';
    if (readerTitle) readerTitle.textContent = story.title || story.slug || 'Untitled Story';
    if (readerSummary) readerSummary.textContent = story.summary || '';

    if (readerTags) {
      const tags = Array.isArray(story.tags) ? story.tags : [];
      readerTags.innerHTML = tags.map(t => `
        <span class="text-xs bg-slate-800 text-purple-300 px-2.5 py-1 rounded-lg border border-purple-500/20">#${t}</span>
      `).join('');
    }

    // Immediately update document title & SEO
    updateStorySeo(story, langCode);

    function attachPromptCopyListeners() {
      // 1. Copy full Hindi / English story text
      readerContent?.querySelectorAll('.copy-full-text-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const text = decodeURIComponent((btn as HTMLElement).getAttribute('data-text') || '');
          navigator.clipboard.writeText(text);
          const orig = btn.textContent;
          btn.textContent = 'Copied Full Story!';
          setTimeout(() => { btn.textContent = orig; }, 2000);
        });
      });

      // 2. Tab switching between Hindi Story and English Story
      readerContent?.querySelectorAll('.story-lang-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          const targetId = (tab as HTMLElement).getAttribute('data-target');
          if (targetId) switchStoryTab(targetId, true);
        });
      });
    }

    function initReaderContent(contentHtml: string) {
      if (!readerContent) return;
      readerContent.innerHTML = contentHtml;
      attachPromptCopyListeners();

      let targetTab = 'tab-hindi';
      if (initialLang === 'en' || initialLang === 'english') {
        targetTab = 'tab-english';
      }
      switchStoryTab(targetTab, false);
    }

    // Story content render (handles markdown or json scenes)
    if (readerContent) {
      if (story.content) {
        initReaderContent(story.content);
      } else {
        readerContent.innerHTML = '<div class="py-16 text-center text-slate-400"><div class="inline-block w-8 h-8 border-3 border-purple-500/30 border-t-purple-500 rounded-full animate-spin mb-3"></div><p>Loading full story text...</p></div>';
        fetchStoryContent(story.path, activeBranch).then(raw => {
          const parsed = parseStoryData(raw, story.path);
          story.content = parsed.htmlContent;
          story.prompts = parsed.prompts;
          if (parsed.title) {
            story.title = parsed.title;
            if (readerTitle) readerTitle.textContent = parsed.title;
          }
          if (parsed.title_hi) story.title_hi = parsed.title_hi;
          if (parsed.title_en) story.title_en = parsed.title_en;
          if (parsed.slug) story.slug = parsed.slug;
          if (parsed.summary) story.summary = parsed.summary;
          if (readerReadTime) readerReadTime.textContent = `• ${parsed.readTime}`;

          initReaderContent(parsed.htmlContent);
        }).catch(err => {
          if (readerContent) {
            readerContent.innerHTML = `<p class="text-red-400 py-8 text-center">Could not load story: ${err.message}</p>`;
          }
        });
      }
    }

    // View on GitHub link
    if (viewOnGithubLink) {
      viewOnGithubLink.href = `https://github.com/${GITHUB_REPO}/blob/${activeBranch}/${story.path}`;
    }
  }

  function closeStoryReader() {
    currentActiveStory = null;
    readerView?.classList.add('hidden');
    catalogView?.classList.remove('hidden');
    document.title = 'Stories Vault | Ivikee7';

    const metaDesc = document.querySelector('meta[name="description"]');
    if (metaDesc) metaDesc.setAttribute('content', 'Bilingual stories and moral narratives in Hindi and English — updated in real time.');
    const ogTitle = document.querySelector('meta[property="og:title"]');
    if (ogTitle) ogTitle.setAttribute('content', 'Stories Vault | Ivikee7');
    const ogDesc = document.querySelector('meta[property="og:description"]');
    if (ogDesc) ogDesc.setAttribute('content', 'Bilingual stories and moral narratives in Hindi and English — updated in real time.');

    const newUrl = new URL(window.location.href);
    newUrl.searchParams.delete('story');
    newUrl.searchParams.delete('slug');
    newUrl.searchParams.delete('lang');
    newUrl.hash = '';
    window.history.pushState({}, '', newUrl.pathname);
  }

  function checkDeepLink() {
    const urlParams = new URLSearchParams(window.location.search);
    const storyParam = urlParams.get('story') || urlParams.get('slug');
    const hash = window.location.hash.replace(/^#/, '');

    const target = storyParam || (hash.startsWith('story=') ? hash.replace('story=', '') : hash);

    if (target) {
      const decoded = decodeURIComponent(target).toLowerCase().trim();
      const cleanTarget = decoded.replace(/\.(json|md|markdown|txt)$/i, '');
      const langParam = urlParams.get('lang') || undefined;

      // If story is already open, just switch tab
      if (currentActiveStory) {
        const curSlug = (currentActiveStory.slug || '').toLowerCase();
        const curClean = currentActiveStory.path.toLowerCase().replace(/\.(json|md|markdown|txt)$/i, '');
        if (curSlug === cleanTarget || curClean === cleanTarget || currentActiveStory.path.toLowerCase() === decoded) {
          let targetTab = 'tab-hindi';
          if (langParam === 'en' || langParam === 'english') targetTab = 'tab-english';
          switchStoryTab(targetTab, false);
          return;
        }
      }

      const story = allStories.find(s => {
        const sPath = s.path.toLowerCase();
        const sCleanPath = sPath.replace(/\.(json|md|markdown|txt)$/i, '');
        const sSlug = (s.slug || '').toLowerCase();
        return sSlug === cleanTarget ||
               sCleanPath === cleanTarget ||
               sPath === decoded ||
               sPath.endsWith('/' + decoded) ||
               sCleanPath.endsWith('/' + cleanTarget) ||
               s.title.toLowerCase().includes(decoded);
      });

      if (story) {
        openStoryReader(story, false, langParam);
      }
    }
  }

  // Event Listeners
  backToCatalogBtn?.addEventListener('click', closeStoryReader);

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderGrid();
  });

  retryBtn?.addEventListener('click', loadStories);

  copyStoryLink?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href);
    const span = copyStoryLink.querySelector('span');
    if (span) {
      span.textContent = 'Copied!';
      setTimeout(() => { span.textContent = 'Copy Link'; }, 2000);
    }
  });

  window.addEventListener('popstate', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('story') || urlParams.get('slug') || window.location.hash) {
      checkDeepLink();
    } else {
      readerView?.classList.add('hidden');
      catalogView?.classList.remove('hidden');
    }
  });

  // Initial fetch
  loadStories();
</script>
