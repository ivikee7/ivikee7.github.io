---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Repositories & Projects | Ivikee7" 
  description="Explore all public GitHub repositories and open-source projects by Ivikee7 dynamically in real time."
>
  <main class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <!-- Header Section -->
    <div class="mb-12 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Live Connected to <a href="https://github.com/ivikee7" target="_blank" rel="noopener noreferrer" class="underline hover:text-indigo-300 ml-1">github.com/ivikee7</a>
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-indigo-300 via-purple-300 to-pink-400 mb-6">
        GitHub Repositories
      </h1>
      <p class="text-slate-400 text-base md:text-xl leading-relaxed">
        Live catalog of all open-source repositories, video tools, scripts, and applications — without manual rebuilds.
      </p>
    </div>

    <!-- Repo Detail View (README & details, hidden by default) -->
    <div id="repo-detail-view" class="hidden">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/10">
          <button id="back-to-repos" class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-400 hover:text-indigo-300 bg-indigo-500/10 hover:bg-indigo-500/20 px-4 py-2 rounded-full transition-all cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to All Repositories
          </button>
          
          <div class="flex items-center gap-3">
            <a id="repo-github-btn" href="#" target="_blank" rel="noopener noreferrer" class="text-xs text-white bg-slate-800 hover:bg-slate-700 px-3.5 py-1.5 rounded-lg border border-white/10 transition-colors flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              <span>Open on GitHub &rarr;</span>
            </a>
          </div>
        </div>

        <article class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-3xl p-6 md:p-12 shadow-2xl">
          <!-- Detail Header -->
          <header class="mb-10 pb-8 border-b border-white/10">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span id="detail-language" class="px-3 py-1 text-xs font-bold rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30"></span>
              <span id="detail-stars" class="text-xs text-slate-400 flex items-center gap-1"></span>
              <span id="detail-forks" class="text-xs text-slate-400 flex items-center gap-1"></span>
              <span id="detail-updated" class="text-xs text-slate-400"></span>
            </div>
            <h1 id="detail-name" class="text-3xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4"></h1>
            <p id="detail-description" class="text-lg text-slate-300 font-light leading-relaxed mb-6"></p>
            <div id="detail-topics" class="flex flex-wrap gap-2 mb-6"></div>

            <!-- Clone Command Box -->
            <div class="flex items-center justify-between bg-slate-950 px-4 py-3 rounded-xl border border-white/10 font-mono text-xs text-slate-300">
              <span id="detail-clone-cmd" class="truncate mr-4"></span>
              <button id="copy-clone-btn" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded-md transition-colors flex-shrink-0">
                Copy
              </button>
            </div>
          </header>

          <!-- Navigation Tabs -->
          <div class="flex items-center gap-3 border-b border-white/10 mb-8 pb-3">
            <button id="tab-readme-btn" class="px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-indigo-600 text-white transition-all shadow-md cursor-pointer">
              📖 README.md
            </button>
            <button id="tab-files-btn" class="px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-slate-800/80 text-slate-300 hover:text-white hover:bg-slate-700 transition-all cursor-pointer">
              📑 Stories & Markdown Pages (<span id="repo-files-count">0</span>)
            </button>
          </div>

          <!-- Section 1: README Content -->
          <div id="section-readme">
            <!-- README Loading Spinner -->
            <div id="readme-loading" class="text-center py-16 hidden">
              <div class="inline-block w-8 h-8 border-3 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin mb-3"></div>
              <p class="text-slate-400 text-xs">Loading README.md...</p>
            </div>

            <!-- README Content -->
            <div id="detail-readme" class="prose prose-invert prose-indigo prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-indigo-400 prose-img:rounded-2xl prose-pre:bg-slate-950 prose-pre:border prose-pre:border-white/10">
            </div>
          </div>

          <!-- Section 2: Markdown Files & Stories List -->
          <div id="section-files" class="hidden">
            <div class="mb-4 text-sm text-slate-400">
              Click any file or story below to read it directly:
            </div>
            <div id="repo-files-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Dynamically populated files -->
            </div>
          </div>

          <!-- Section 3: In-Repo Markdown File Reader -->
          <div id="section-file-reader" class="hidden">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/10">
              <button id="back-to-file-list-btn" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 bg-indigo-500/10 hover:bg-indigo-500/20 px-3.5 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer">
                &larr; Back to Files
              </button>
              <span id="active-file-path" class="text-xs font-mono text-slate-400 truncate max-w-xs md:max-w-md"></span>
            </div>
            <div id="active-file-content" class="prose prose-invert prose-indigo prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-indigo-400 prose-img:rounded-2xl">
              <!-- Content rendered here -->
            </div>
          </div>
        </article>
      </div>
    </div>

    <!-- Catalog Explorer View -->
    <div id="repo-catalog-view">
      <!-- Search & Filters -->
      <div class="mb-10 space-y-6">
        <!-- Search Bar -->
        <div class="relative max-w-xl mx-auto">
          <input 
            type="text" 
            id="repo-search" 
            placeholder="Search repositories, technologies, or topics..." 
            class="w-full pl-12 pr-4 py-3.5 bg-slate-900/80 border border-white/10 rounded-2xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all shadow-inner"
          />
          <svg class="w-5 h-5 text-slate-500 absolute left-4 top-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Language Filter Pills -->
        <div id="language-pills" class="flex flex-wrap items-center justify-center gap-2">
          <button data-lang="all" class="lang-pill active px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-indigo-600 text-white shadow-lg shadow-indigo-600/30">
            All Repos (<span id="count-all-repos">0</span>)
          </button>
        </div>
      </div>

      <!-- Loading State -->
      <div id="repos-loading" class="text-center py-24">
        <div class="inline-block w-10 h-10 border-4 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin mb-4"></div>
        <p class="text-slate-400 text-sm">Fetching public repositories for <code class="text-indigo-300">ivikee7</code>...</p>
      </div>

      <!-- Error State -->
      <div id="repos-error" class="hidden max-w-xl mx-auto text-center py-16 px-6 rounded-3xl bg-red-950/20 border border-red-500/30">
        <div class="text-red-400 text-3xl mb-3">⚠️</div>
        <h3 class="text-xl font-bold text-white mb-2">Unable to Load Repositories</h3>
        <p id="repos-error-message" class="text-slate-400 text-sm mb-6"></p>
        <button id="repos-retry-btn" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-colors">
          Retry
        </button>
      </div>

      <!-- Repos Grid -->
      <div id="repos-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>
  </main>
</Layout>

<script>
  import { marked } from 'https://cdn.jsdelivr.net/npm/marked@15.0.7/+esm';

  const GITHUB_USER = 'ivikee7';
  const REPOS_API_URL = `https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=100`;

  interface RepoMeta {
    id: number;
    name: string;
    full_name: string;
    description: string;
    html_url: string;
    clone_url: string;
    language: string;
    stargazers_count: number;
    forks_count: number;
    updated_at: string;
    topics: string[];
    default_branch: string;
  }

  let allRepos: RepoMeta[] = [];
  let currentLanguage = 'all';
  let repoSearchQuery = '';

  const reposLoading = document.getElementById('repos-loading');
  const reposError = document.getElementById('repos-error');
  const reposErrorMessage = document.getElementById('repos-error-message');
  const reposGrid = document.getElementById('repos-grid');
  const langPills = document.getElementById('language-pills');
  const searchInput = document.getElementById('repo-search') as HTMLInputElement;
  const countAllEl = document.getElementById('count-all-repos');
  const catalogView = document.getElementById('repo-catalog-view');
  const detailView = document.getElementById('repo-detail-view');
  const retryBtn = document.getElementById('repos-retry-btn');

  // Detail View Elements
  const backToReposBtn = document.getElementById('back-to-repos');
  const detailName = document.getElementById('detail-name');
  const detailDescription = document.getElementById('detail-description');
  const detailLanguage = document.getElementById('detail-language');
  const detailStars = document.getElementById('detail-stars');
  const detailForks = document.getElementById('detail-forks');
  const detailUpdated = document.getElementById('detail-updated');
  const detailTopics = document.getElementById('detail-topics');
  const detailCloneCmd = document.getElementById('detail-clone-cmd');
  const copyCloneBtn = document.getElementById('copy-clone-btn');
  const repoGithubBtn = document.getElementById('repo-github-btn') as HTMLAnchorElement;
  const detailReadme = document.getElementById('detail-readme');
  const readmeLoading = document.getElementById('readme-loading');

  // Tabs & File Explorer Elements
  const tabReadmeBtn = document.getElementById('tab-readme-btn');
  const tabFilesBtn = document.getElementById('tab-files-btn');
  const sectionReadme = document.getElementById('section-readme');
  const sectionFiles = document.getElementById('section-files');
  const sectionFileReader = document.getElementById('section-file-reader');
  const repoFilesCount = document.getElementById('repo-files-count');
  const repoFilesList = document.getElementById('repo-files-list');
  const backToFilesBtn = document.getElementById('back-to-file-list-btn');
  const activeFilePath = document.getElementById('active-file-path');
  const activeFileContent = document.getElementById('active-file-content');

  let currentRepo: RepoMeta | null = null;
  let currentRepoFiles: any[] = [];

  function switchTab(tab: 'readme' | 'files' | 'reader') {
    if (tab === 'readme') {
      sectionReadme?.classList.remove('hidden');
      sectionFiles?.classList.add('hidden');
      sectionFileReader?.classList.add('hidden');
      if (tabReadmeBtn) tabReadmeBtn.className = 'px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-indigo-600 text-white transition-all shadow-md cursor-pointer';
      if (tabFilesBtn) tabFilesBtn.className = 'px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-slate-800/80 text-slate-300 hover:text-white hover:bg-slate-700 transition-all cursor-pointer';
    } else if (tab === 'files') {
      sectionReadme?.classList.add('hidden');
      sectionFiles?.classList.remove('hidden');
      sectionFileReader?.classList.add('hidden');
      if (tabFilesBtn) tabFilesBtn.className = 'px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-indigo-600 text-white transition-all shadow-md cursor-pointer';
      if (tabReadmeBtn) tabReadmeBtn.className = 'px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-slate-800/80 text-slate-300 hover:text-white hover:bg-slate-700 transition-all cursor-pointer';
    } else if (tab === 'reader') {
      sectionReadme?.classList.add('hidden');
      sectionFiles?.classList.add('hidden');
      sectionFileReader?.classList.remove('hidden');
    }
  }

  tabReadmeBtn?.addEventListener('click', () => switchTab('readme'));
  tabFilesBtn?.addEventListener('click', () => switchTab('files'));
  backToFilesBtn?.addEventListener('click', () => switchTab('files'));

  async function loadRepos() {
    try {
      reposLoading?.classList.remove('hidden');
      reposError?.classList.add('hidden');
      if (reposGrid) reposGrid.innerHTML = '';

      const res = await fetch(REPOS_API_URL);
      if (!res.ok) {
        if (res.status === 403) {
          throw new Error('GitHub API rate limit reached. Please wait a few moments or try again.');
        }
        throw new Error(`GitHub responded with status ${res.status}`);
      }

      const data = await res.json();
      allRepos = Array.isArray(data) ? data : [];

      if (countAllEl) countAllEl.textContent = String(allRepos.length);

      renderLanguagePills();
      renderGrid();
      checkDeepLink();

    } catch (err: any) {
      console.error(err);
      reposLoading?.classList.add('hidden');
      reposError?.classList.remove('hidden');
      if (reposErrorMessage) {
        reposErrorMessage.textContent = err.message || 'Failed to load repositories from GitHub.';
      }
    } finally {
      reposLoading?.classList.add('hidden');
    }
  }

  function renderLanguagePills() {
    if (!langPills) return;
    const languages = Array.from(new Set(allRepos.map(r => r.language).filter(Boolean)));

    langPills.innerHTML = `
      <button data-lang="all" class="lang-pill active px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-indigo-600 text-white shadow-lg shadow-indigo-600/30">
        All Repos (${allRepos.length})
      </button>
      ${languages.map(lang => {
        const count = allRepos.filter(r => r.language === lang).length;
        return `
          <button data-lang="${lang}" class="lang-pill px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-white/10">
            ${lang} (${count})
          </button>
        `;
      }).join('')}
    `;

    langPills.querySelectorAll('.lang-pill').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const lang = target.getAttribute('data-lang') || 'all';
        currentLanguage = lang;

        langPills.querySelectorAll('.lang-pill').forEach(b => {
          b.className = 'lang-pill px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-white/10';
        });

        target.className = 'lang-pill active px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-indigo-600 text-white shadow-lg shadow-indigo-600/30';
        renderGrid();
      });
    });
  }

  function renderGrid() {
    if (!reposGrid) return;

    const filtered = allRepos.filter(repo => {
      const matchesLang = currentLanguage === 'all' || repo.language === currentLanguage;
      const q = repoSearchQuery.toLowerCase();
      const matchesSearch = !q || 
        repo.name.toLowerCase().includes(q) || 
        (repo.description && repo.description.toLowerCase().includes(q)) ||
        (repo.language && repo.language.toLowerCase().includes(q)) ||
        (repo.topics && repo.topics.some(t => t.toLowerCase().includes(q)));

      return matchesLang && matchesSearch;
    });

    if (filtered.length === 0) {
      reposGrid.innerHTML = `
        <div class="col-span-full text-center py-16">
          <p class="text-slate-400 text-lg">No repositories found matching your filter.</p>
        </div>
      `;
      return;
    }

    reposGrid.innerHTML = filtered.map(repo => {
      const updatedDate = new Date(repo.updated_at).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });

      return `
        <div 
          data-repo-name="${repo.name}"
          class="repo-card group relative flex flex-col justify-between rounded-3xl bg-slate-900/40 backdrop-blur-sm border border-white/10 p-7 hover:bg-slate-800/60 hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_10px_40px_rgba(99,102,241,0.15)] cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                ${repo.language || 'Code'}
              </span>
              <div class="flex items-center gap-3 text-xs text-slate-400">
                <span class="flex items-center gap-1">★ ${repo.stargazers_count}</span>
                <span class="flex items-center gap-1">⑂ ${repo.forks_count}</span>
              </div>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-indigo-300 transition-colors mb-3 leading-snug">
              ${repo.name}
            </h3>

            <p class="text-slate-400 text-sm leading-relaxed mb-6 line-clamp-3">
              ${repo.description || 'No description provided.'}
            </p>
          </div>

          <div>
            ${repo.topics && repo.topics.length > 0 ? `
              <div class="flex flex-wrap gap-1.5 mb-6">
                ${repo.topics.slice(0, 3).map(t => `
                  <span class="text-[10px] bg-slate-800/90 text-slate-400 px-2 py-0.5 rounded-md border border-white/5">#${t}</span>
                `).join('')}
              </div>
            ` : ''}

            <div class="flex items-center justify-between text-xs text-slate-500 pt-4 border-t border-white/5">
              <span>Updated ${updatedDate}</span>
              <span class="text-indigo-400 font-semibold group-hover:translate-x-1 transition-transform">
                View Project &rarr;
              </span>
            </div>
          </div>
        </div>
      `;
    }).join('');

    reposGrid.querySelectorAll('.repo-card').forEach(card => {
      card.addEventListener('click', () => {
        const name = card.getAttribute('data-repo-name');
        const repo = allRepos.find(r => r.name === name);
        if (repo) openRepoDetail(repo);
      });
    });
  }

  async function openRepoDetail(repo: RepoMeta, updateUrl = true) {
    if (detailName) detailName.textContent = repo.name;
    if (detailDescription) detailDescription.textContent = repo.description || 'No description provided.';
    if (detailLanguage) detailLanguage.textContent = repo.language || 'Project';
    if (detailStars) detailStars.innerHTML = `★ ${repo.stargazers_count} stars`;
    if (detailForks) detailForks.innerHTML = `⑂ ${repo.forks_count} forks`;
    if (detailUpdated) {
      detailUpdated.textContent = `Updated ${new Date(repo.updated_at).toLocaleDateString()}`;
    }

    if (detailTopics) {
      detailTopics.innerHTML = (repo.topics || []).map(t => `
        <span class="text-xs bg-slate-800 text-indigo-300 px-2.5 py-1 rounded-lg border border-indigo-500/20">#${t}</span>
      `).join('');
    }

    const cloneCmd = `git clone ${repo.clone_url}`;
    if (detailCloneCmd) detailCloneCmd.textContent = cloneCmd;

    copyCloneBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(cloneCmd);
      if (copyCloneBtn) {
        copyCloneBtn.textContent = 'Copied!';
        setTimeout(() => { copyCloneBtn.textContent = 'Copy'; }, 2000);
      }
    });

    if (repoGithubBtn) {
      repoGithubBtn.href = repo.html_url;
    }

    currentRepo = repo;
    switchTab('readme');

    // Fetch README
    if (detailReadme) detailReadme.innerHTML = '';
    readmeLoading?.classList.remove('hidden');

    try {
      let readmeMd = '';
      const activeBranch = repo.default_branch || 'main';
      const rawRes = await fetch(`https://raw.githubusercontent.com/${GITHUB_USER}/${repo.name}/${activeBranch}/README.md`);
      if (rawRes.ok) {
        readmeMd = await rawRes.text();
      } else {
        const apiRes = await fetch(`https://api.github.com/repos/${GITHUB_USER}/${repo.name}/readme`);
        if (apiRes.ok) {
          const apiData = await apiRes.json();
          if (apiData.content) {
            const binaryString = atob(apiData.content.replace(/\s/g, ''));
            const bytes = Uint8Array.from(binaryString, c => c.charCodeAt(0));
            readmeMd = new TextDecoder('utf-8').decode(bytes);
          }
        }
      }

      readmeLoading?.classList.add('hidden');
      if (detailReadme) {
        if (readmeMd) {
          detailReadme.innerHTML = marked.parse(readmeMd);

          // Intercept links inside README so clicking on stories or folders opens them directly!
          detailReadme.querySelectorAll('a').forEach(a => {
            const href = a.getAttribute('href');
            if (href && !href.startsWith('http') && !href.startsWith('#')) {
              a.addEventListener('click', (ev) => {
                ev.preventDefault();
                const cleanHref = href.replace(/^\.?\//, '').toLowerCase();
                const matchedFile = currentRepoFiles.find(f => f.path.toLowerCase().includes(cleanHref));
                if (matchedFile) {
                  openRepoFile(repo, matchedFile.path);
                } else {
                  switchTab('files');
                }
              });
            }
          });
        } else {
          detailReadme.innerHTML = '<p class="text-slate-400 italic">No README.md found in this repository.</p>';
        }
      }
    } catch (e) {
      readmeLoading?.classList.add('hidden');
      if (detailReadme) {
        detailReadme.innerHTML = '<p class="text-slate-400 italic">Could not load README.</p>';
      }
    }

    // Fetch all files in the repository for the Files / Stories tab
    currentRepoFiles = [];
    try {
      const activeBranch = repo.default_branch || 'main';
      const treeRes = await fetch(`https://api.github.com/repos/${GITHUB_USER}/${repo.name}/git/trees/${activeBranch}?recursive=1`);
      if (treeRes.ok) {
        const treeData = await treeRes.json();
        currentRepoFiles = (treeData.tree || []).filter((item: any) => 
          item.type === 'blob' && /\.(md|markdown|txt)$/i.test(item.path) && !/readme\.md$/i.test(item.path)
        );
      }
    } catch (_) {}

    if (repoFilesCount) repoFilesCount.textContent = String(currentRepoFiles.length);

    if (repoFilesList) {
      if (currentRepoFiles.length === 0) {
        repoFilesList.innerHTML = '<p class="col-span-full text-slate-400 py-6 text-sm">No additional markdown files or stories found in this repository.</p>';
      } else {
        repoFilesList.innerHTML = currentRepoFiles.map((f: any) => {
          const parts = f.path.split('/');
          const filename = parts.pop();
          const folder = parts.join(' / ') || 'root';
          const isHindi = f.path.toLowerCase().includes('_hi.') || f.path.toLowerCase().includes('hindi');
          const isEnglish = f.path.toLowerCase().includes('_en.') || f.path.toLowerCase().includes('english');

          return `
            <div data-file-path="${f.path}" class="repo-file-card p-5 rounded-2xl bg-slate-950/60 border border-white/5 hover:border-indigo-500/50 hover:bg-slate-800/60 transition-all cursor-pointer flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-[11px] font-mono text-indigo-400 truncate">${folder}</span>
                  ${isHindi ? '<span class="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded font-bold">🇮🇳 Hindi</span>' : ''}
                  ${isEnglish ? '<span class="text-[10px] bg-blue-500/20 text-blue-300 px-2 py-0.5 rounded font-bold">🇺🇸 English</span>' : ''}
                </div>
                <h4 class="text-base font-bold text-white group-hover:text-indigo-300 transition-colors mb-1 truncate">${filename}</h4>
              </div>
              <div class="mt-4 text-xs text-indigo-400 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                Read Story / Page &rarr;
              </div>
            </div>
          `;
        }).join('');

        repoFilesList.querySelectorAll('.repo-file-card').forEach(card => {
          card.addEventListener('click', () => {
            const path = card.getAttribute('data-file-path');
            if (path) openRepoFile(repo, path);
          });
        });
      }
    }

    if (updateUrl) {
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('repo', repo.name);
      history.pushState({ repoName: repo.name }, repo.name, newUrl.toString());
    }

    catalogView?.classList.add('hidden');
    detailView?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  async function openRepoFile(repo: RepoMeta, filePath: string) {
    switchTab('reader');
    if (activeFilePath) activeFilePath.textContent = filePath;
    if (activeFileContent) {
      activeFileContent.innerHTML = '<div class="py-16 text-center text-slate-400"><div class="inline-block w-8 h-8 border-3 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin mb-3"></div><p>Loading file...</p></div>';
    }

    try {
      let rawText = '';
      const activeBranch = repo.default_branch || 'main';
      const rawRes = await fetch(`https://raw.githubusercontent.com/${GITHUB_USER}/${repo.name}/${activeBranch}/${filePath}`);
      if (rawRes.ok) {
        rawText = await rawRes.text();
      } else {
        const apiRes = await fetch(`https://api.github.com/repos/${GITHUB_USER}/${repo.name}/contents/${filePath}?ref=${activeBranch}`);
        if (apiRes.ok) {
          const apiData = await apiRes.json();
          if (apiData.content) {
            const binaryString = atob(apiData.content.replace(/\s/g, ''));
            const bytes = Uint8Array.from(binaryString, c => c.charCodeAt(0));
            rawText = new TextDecoder('utf-8').decode(bytes);
          }
        }
      }

      if (activeFileContent) {
        // Strip frontmatter from display
        const cleanText = rawText.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/, '');
        activeFileContent.innerHTML = marked.parse(cleanText || rawText);
      }

      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('repo', repo.name);
      newUrl.searchParams.set('file', filePath);
      history.pushState({ repoName: repo.name, filePath }, filePath, newUrl.toString());
      window.scrollTo({ top: 0, behavior: 'smooth' });

    } catch (e: any) {
      if (activeFileContent) {
        activeFileContent.innerHTML = `<p class="text-red-400 py-8 text-center">Failed to load file: ${e.message}</p>`;
      }
    }
  }

  function closeRepoDetail() {
    detailView?.classList.add('hidden');
    catalogView?.classList.remove('hidden');
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.delete('repo');
    newUrl.hash = '';
    history.pushState({}, document.title, newUrl.pathname);
  }

  function checkDeepLink() {
    const urlParams = new URLSearchParams(window.location.search);
    const repoParam = urlParams.get('repo') || urlParams.get('name') || urlParams.get('slug');
    const fileParam = urlParams.get('file');
    const hash = window.location.hash.replace(/^#/, '');

    const target = repoParam || (hash.startsWith('repo=') ? hash.replace('repo=', '') : hash);

    if (target) {
      const decoded = decodeURIComponent(target).toLowerCase();
      const repo = allRepos.find(r => r.name.toLowerCase() === decoded);
      if (repo) {
        openRepoDetail(repo, false);
        if (fileParam) {
          openRepoFile(repo, decodeURIComponent(fileParam));
        }
      }
    }
  }

  // Event Listeners
  backToReposBtn?.addEventListener('click', closeRepoDetail);

  searchInput?.addEventListener('input', (e) => {
    repoSearchQuery = (e.target as HTMLInputElement).value;
    renderGrid();
  });

  retryBtn?.addEventListener('click', loadRepos);

  window.addEventListener('popstate', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('repo')) {
      checkDeepLink();
    } else {
      detailView?.classList.add('hidden');
      catalogView?.classList.remove('hidden');
    }
  });

  // Initial fetch
  loadRepos();
</script>
