---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPages = await getCollection('pages');
---
<Layout title="Pages | Ivikee7">
  <main class="max-w-7xl mx-auto px-6 py-24">
    <div class="mb-16 text-center max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-purple-300 to-pink-400 mb-6">Pages & Articles</h1>
      <p class="text-slate-400 text-lg md:text-xl">Explore standard pages, about sections, and static content collections.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allPages.map((page) => (
        <a href={`/pages/${page.id}`} class="group relative flex flex-col justify-between rounded-3xl bg-slate-900/40 backdrop-blur-sm border border-white/10 p-8 hover:bg-slate-800/60 hover:border-purple-500/50 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_10px_40px_rgba(168,85,247,0.1)]">
          <div>
            <h2 class="text-2xl font-bold text-slate-200 group-hover:text-white transition-colors mb-3">{page.data.title}</h2>
            <p class="text-slate-400 text-sm leading-relaxed">{page.data.description}</p>
          </div>
          <div class="mt-8 flex items-center text-purple-400 text-sm font-semibold opacity-0 group-hover:opacity-100 group-hover:-translate-y-1 transition-all">
            View Page &rarr;
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>